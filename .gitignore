# Secrets — nunca commitear
.env

# Configuración específica del servidor (subdominio ↔ puerto, authelia settings)
# Editar config.example.yml como plantilla y copiar a config.yml en cada servidor
config.yml

# Datos en runtime (base de datos sqlite de Authelia, notificaciones)
data/

# Certificados SSL generados por Certbot
nginx/certs/
nginx/certbot-data/

# Configuración nginx generada en runtime por setup.ts
nginx/nginx.conf

# Dependencias Node
node_modules/

# Estado del setup (progreso de instalación, no versionado)
.setup-state
