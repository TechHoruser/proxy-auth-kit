# Token de DuckDNS (obténlo en https://www.duckdns.org)
TOKEN=tu_token_duckdns

# Los siguientes secretos se generan automáticamente con: npm run setup
# Puedes dejarlos vacíos; el script los completará la primera vez.
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# Estas variables las escribe el script automáticamente desde config.yml:
# DOMAIN=
# AUTHELIA_TOTP_ISSUER=
# AUTHELIA_DEFAULT_REDIRECTION_URL=
