# ---------------------------------------------------------------------------
# DuckDNS
# ---------------------------------------------------------------------------

# Tu dominio en DuckDNS, p.ej: miproyecto.duckdns.org
DOMAIN=miproyecto.duckdns.org

# Token de DuckDNS (obténlo en https://www.duckdns.org → tu cuenta)
TOKEN=tu_token_duckdns

# ---------------------------------------------------------------------------
# Authelia — secretos de seguridad
# ---------------------------------------------------------------------------
# Puedes dejarlos vacíos: npm run setup los genera automáticamente la primera vez.
# Si ya tienes valores, cópialos aquí para no regenerarlos en cada setup.

AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Authelia — configuración (el script la sobreescribe desde config.yml)
# ---------------------------------------------------------------------------
AUTHELIA_TOTP_ISSUER=
